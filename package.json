{
  "name": "reconcileiq",
  "version": "1.0.0",
  "private": true,
  "description": "Invoice payment tracking and reconciliation workspace",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "setup": "node --env-file-if-exists=.env scripts/setup.js",
    "build": "node scripts/build.js",
    "test": "node --test reconciliation.test.js server.test.js netlify.test.js onedrive.test.js import.test.js bulk.test.js"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.2",
    "csv-parse": "7.0.3",
    "pg": "^8.23.1",
    "read-excel-file": "9.3.14",
    "sax": "1.6.1",
    "saxen": "11.2.0",
    "serverless-http": "4.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "netlify-cli": "27.16.2"
  }
}
