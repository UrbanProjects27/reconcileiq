{
  "name": "reconcileiq",
  "version": "1.0.0",
  "private": true,
  "description": "Invoice payment tracking and reconciliation workspace",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "setup": "node --env-file-if-exists=.env scripts/setup.js",
