# Local development needs no DATABASE_URL; it uses data/reconcileiq.sqlite.
# Copy this file to .env only if you need environment configuration.
PORT=4173
HOST=127.0.0.1
# Set these only for initial admin bootstrap, then remove ADMIN_PASSWORD.
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Workspace Admin
# ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Production requires PostgreSQL and the exact public HTTPS origin.
# DATABASE_URL=postgresql://user:password@host:5432/reconcileiq
# APP_ORIGIN=https://your-app.netlify.app
# NODE_ENV=production

# Netlify + Supabase runtime configuration (set in Netlify UI/CLI/API):
# DATABASE_SCHEMA=reconcileiq
# DATABASE_SCHEMA_READY=true
# DATABASE_POOL_MAX=2
# DATABASE_SSL=true
# DATABASE_SSL_CA=optional-project-root-certificate-if-needed
# AWS_LAMBDA_JS_RUNTIME=nodejs24.x
# Use the Supabase transaction pooler URI (port 6543) for DATABASE_URL.
